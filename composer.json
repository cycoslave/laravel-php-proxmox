{
    "name": "cycoslave/laravel-proxmox",
    "description": "A Proxmox API integration for Laravel (multi-connection capable fork)",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/cycoslave/laravel-proxmox",
    "keywords": [
        "laravel",
        "laravel proxmox",
        "proxmox",
        "proxmox api",
        "proxmox api client"
    ],
    "authors": [
        {
            "name": "Fazle Rabbi",
            "email": "fazrabbi360@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Tony Roy",
            "email": "tonyroy@wcksoft.com",
            "role": "Maintainer (fork)"
        }
    ],
    "autoload": {
        "psr-4": {
            "Cycoslave\\Proxmox\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cycoslave\\Proxmox\\ProxmoxServiceProvider"
            ],
            "aliases": {
                "ProxmoxNodeVM": "ProxmoxNode",
                "ProxmoxCluster": "Irabbi360\\Proxmox\\Facades\\ProxmoxCluster",
                "ProxmoxStorage": "Irabbi360\\Proxmox\\Facades\\ProxmoxStorage"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
